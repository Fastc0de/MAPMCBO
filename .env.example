# Copia este archivo como .env.local y rellena tus claves. .env.local no se sube al repo.

# --- Google Maps Platform ---
# Con una sola clave basta (sirve la Maps Demo Key): mapa, Places API (New), Geocoding API v4 y Routes API.
GOOGLE_MAPS_API_KEY=

# Opcional: claves separadas (más seguro en producción). Si están, tienen prioridad sobre GOOGLE_MAPS_API_KEY.
# GOOGLE_MAPS_BROWSER_API_KEY=   # solo Maps JavaScript API, restringida por dominio
# GOOGLE_MAPS_SERVER_API_KEY=    # Places API (New), Geocoding API, Routes API; nunca llega al navegador
# GOOGLE_MAPS_MAP_ID=            # Map ID propio; sin él se usa DEMO_MAP_ID

# --- Modelos para el chat (pon una o varias; en el chat eliges cuál usar) ---
# Gemini (Google AI Studio, tiene nivel gratuito)
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.8-flash

# OpenCode Go (suscripción de OpenCode; solo modelos de /chat/completions)
OPENCODE_GO_API_KEY=
# OPENCODE_GO_MODELS=kimi-k3,glm-5.3,deepseek-v4-pro

# Claude (API de Anthropic, de pago; la suscripción de claude.ai no sirve aquí)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max

# Cualquier otro proveedor compatible con OpenAI (OpenRouter, Ollama en tu PC, ...)
# OPENAI_COMPATIBLE_NAME=Ollama
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODELS=qwen3:8b

# Modelo que aparece seleccionado por defecto (proveedor:modelo)
# LLM_DEFAULT_MODEL=gemini:gemini-3.8-flash

# --- Búsqueda web ---
# Claude trae la suya. Para los demás modelos hace falta Tavily (tiene plan gratuito).
TAVILY_API_KEY=
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_MAX_USES=5          # búsquedas web máximas por mensaje (solo Claude)
