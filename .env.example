# Copia este archivo como .env.local y rellena tus claves. .env.local no se sube al repo.

# --- Google Maps Platform ---
# Clave para el mapa en el navegador (Maps JavaScript API).
# Restríngela en Google Cloud por "Sitios web" (HTTP referrers) y por API a "Maps JavaScript API".
GOOGLE_MAPS_BROWSER_API_KEY=

# Clave solo del servidor (Places API (New), Geocoding API, Routes API). Nunca llega al navegador.
# Restríngela por API a esas tres.
GOOGLE_MAPS_SERVER_API_KEY=

# Opcional: Map ID propio (Google Cloud > Map Management). Sin él se usa DEMO_MAP_ID.
GOOGLE_MAPS_MAP_ID=

# --- Chatbot (Claude, de Anthropic) ---
ANTHROPIC_API_KEY=

# Opcionales
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max
# WEB_SEARCH_ENABLED=true        # búsqueda web del chatbot (rutas de transporte, noticias, negocios)
# WEB_SEARCH_MAX_USES=5          # búsquedas web máximas por mensaje
